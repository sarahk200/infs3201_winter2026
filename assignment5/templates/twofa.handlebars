<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Verify Your Identity</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="login-container">
        <h1>Two-Factor Authentication</h1>
        <p>A 6-digit verification code has been sent to your email. Please enter it below.</p>
        <p><strong>This code expires in 3 minutes.</strong></p>

        {{#if error}}
            <p class="error">{{error}}</p>
        {{/if}}

        <form method="POST" action="/2fa">
            <label for="code">Verification Code:</label>
            <input type="text" id="code" name="code" maxlength="6" placeholder="Enter 6-digit code" required>
            <button type="submit">Verify</button>
        </form>

        <p><a href="/login">Back to Login</a></p>
    </div>
</body>
</html>
